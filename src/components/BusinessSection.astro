---
import { Bot, Calendar, Code, Users } from "lucide-astro";
import { services } from "../data/services";

const iconMap = {
  Bot,
  Code,
  Users,
};
---

<section id="business" class="py-16 lg:py-24 w-full flex flex-col items-center">
  <div class="w-full flex flex-col gap-2.5 items-start mb-10">
    <p class="font-mono font-medium text-xs tracking-[0.6px] bg-clip-text text-transparent bg-gradient-to-r from-[#DA2984] to-[#A406E9] uppercase">
      04 — EMPRESAS & STARTUPS
    </p>
    <h2 class="font-bold text-3xl sm:text-4xl text-white tracking-tight">
      Consultoría Tecnológica.
    </h2>
    <p class="text-[#a0a0b4] text-base sm:text-[17px] leading-relaxed max-w-[640px]">
      Te ayudo a migrar al enfoque AI-First, estructurar arquitecturas robustas en Angular/Node.js y eliminar la deuda técnica antes de que sea costosa.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full items-stretch mb-14">
    {services.map((service) => {
      const IconComponent = iconMap[service.iconName];
      return (
        <div class="bg-white/[0.03] border border-white/[0.08] rounded-[20px] p-7 flex flex-col justify-between gap-6 relative overflow-hidden transition-all duration-300 hover:border-[#DA2984]/80 hover:bg-[linear-gradient(225deg,rgba(26,20,46,0.95)_13%,rgba(18,14,34,0.95)_86%)] hover:shadow-xl hover:shadow-purple-950/40 group min-h-[260px]">
          <div class="w-11 h-11 rounded-[12px] bg-gradient-to-r from-[#DA2984] to-[#A406E9] flex items-center justify-center shrink-0 shadow-md shadow-purple-900/30 group-hover:scale-105 transition-transform">
            <IconComponent size={22} class="text-white" />
          </div>
          <div class="flex flex-col gap-2">
            <h3 class="font-semibold text-lg lg:text-xl text-white group-hover:text-white transition-colors">{service.title}</h3>
            <p class="text-[#a0a0b4] text-xs lg:text-sm leading-relaxed">{service.description}</p>
          </div>
        </div>
      );
    })}
  </div>

  <div class="w-full flex justify-center mt-4">
    <a href="mailto:rodrigo.torricodelcastillo@gmail.com?subject=Consultor%C3%ADa%20B2B%20Tokidev" class="flex items-center gap-3 px-10 py-4 bg-gradient-to-r from-[#DA2984] to-[#A406E9] rounded-full text-sm font-bold text-white shadow-[0px_12px_28px_-4px_rgba(218,41,132,0.35)] hover:scale-[1.03] transition-transform cursor-pointer">
      <Calendar size={16} />
      Agendar Consultoría B2B
    </a>
  </div>
</section>
