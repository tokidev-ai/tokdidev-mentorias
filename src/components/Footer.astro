---
import { Github, Instagram, Linkedin, Mail } from "lucide-astro";

const socialLinks = [
  { icon: Linkedin, href: "https://www.linkedin.com/in/tokidev/", label: "LinkedIn" },
  { icon: Github, href: "https://github.com/tokidev-ai", label: "GitHub" },
  { icon: Instagram, href: "https://www.instagram.com/tokidev.ai/", label: "Instagram" },
  { icon: Mail, href: "mailto:rodrigo.torricodelcastillo@gmail.com", label: "Email" },
];
---

<footer class="w-full py-10 mt-12 border-t border-brand-border/10 flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4">
  {/* Información de marca */}
  <div class="flex items-center gap-3">
    <div class="w-8 h-8 rounded-lg bg-linear-to-br from-brand-orange to-brand-yellow flex items-center justify-center">
      <span class="text-white font-bold text-lg leading-none">t</span>
    </div>
    <div class="flex flex-col text-left">
      <span class="text-sm font-bold text-brand-text/90 leading-tight tracking-tight">Tokidev Mentorías</span>
      <span class="text-[10px] font-medium text-brand-text/30 uppercase tracking-wider">Software, carrera y criterio técnico</span>
    </div>
  </div>

  {/* Redes Sociales */}
  <div class="flex gap-3">
    {socialLinks.map((social) => (
      <a href={social.href} aria-label={social.label} target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-xl bg-[#2d2550]/40 border border-brand-border/12 text-brand-orange/70 hover:text-brand-orange hover:bg-[#2d2550]/60 transition-all border-solid">
        <social.icon size={16} />
      </a>
    ))}
  </div>

  {/* Copyright */}
  <div class="text-[11px] text-brand-text/25 font-mono">
    © {new Date().getFullYear()} Tokidev. All rights reserved.
  </div>
</footer>
