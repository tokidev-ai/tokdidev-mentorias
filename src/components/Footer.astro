---
import { Github, Instagram, Linkedin, Mail } from "lucide-astro";

const socialLinks = [
  { icon: Linkedin, href: "https://www.linkedin.com/in/tokidev/", label: "LinkedIn" },
  { icon: Github, href: "https://github.com/tokidev-ai", label: "GitHub" },
  { icon: Instagram, href: "https://www.instagram.com/tokidev.ai/", label: "Instagram" },
  { icon: Mail, href: "mailto:rodrigo.torricodelcastillo@gmail.com", label: "Email" },
];
---

<footer class="w-full flex justify-center border-t border-white/10 mt-16">
  <div class="w-[92%] max-w-[1120px] py-12 flex flex-col md:flex-row items-center justify-between gap-6 md:gap-4">
    {/* Información de marca */}
    <div class="flex items-center gap-3 shrink-0">
      <div class="h-9 w-auto flex items-center justify-center shrink-0">
        <img 
          src="/assets/logos/IsotivoTokidev.svg" 
          alt="Tokidev Isotipo" 
          class="h-9 w-auto object-contain"
        />
      </div>
      <div class="flex flex-col items-start leading-none gap-0.5">
        <span class="text-white font-bold text-base tracking-tight">Tokidev Mentorías</span>
        <span class="text-[#a0a0b4] text-[10px] font-medium uppercase tracking-wider">Software, carrera y criterio técnico</span>
      </div>
    </div>

    {/* Redes Sociales */}
    <div class="flex gap-3">
      {socialLinks.map((social) => (
        <a 
          href={social.href} 
          aria-label={social.label} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="backdrop-blur-[5px] bg-white/5 border border-white/10 flex items-center justify-center rounded-xl w-11 h-11 hover:bg-white/10 hover:border-white/20 hover:scale-105 transition-all duration-300 shadow-md shadow-purple-950/20 text-white cursor-pointer"
        >
          <social.icon size={18} />
        </a>
      ))}
    </div>

    {/* Copyright */}
    <div class="text-[11px] text-[#a0a0b4]/60 font-mono">
      © {new Date().getFullYear()} Tokidev. All rights reserved.
    </div>
  </div>
</footer>
