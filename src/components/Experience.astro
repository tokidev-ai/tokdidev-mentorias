---
import ExperienceCard from "./ExperienceCard.astro";

const experiences = [
  {
    company: "Software real",
    role: "Senior Engineer",
    period: "10+ anos",
    description: "Experiencia construyendo productos, arquitecturas escalables y equipos que necesitan entregar con calidad.",
    color: "#ef6c4a",
    isCurrent: true,
  },
  {
    company: "Mentoria",
    role: "Technical Coach",
    period: "1:1",
    description: "Acompanamiento directo para developers que quieren mejorar codigo, criterio, comunicacion y confianza.",
    color: "#f5a623",
  },
  {
    company: "Comunidad",
    role: "Speaker & Lead",
    period: "LATAM",
    description: "Participacion en comunidades tech, charlas y espacios de aprendizaje para developers en crecimiento.",
    color: "#7b5ea7",
  },
];
---

<section id="experience" class="py-12 md:py-20 flex justify-center">
  <div class="w-full flex flex-col items-center">
    <div class="w-full flex flex-col items-start lg:items-end mb-12 md:mb-16" data-section-label>
      <div class="flex items-center gap-2 mb-2">
        <div class="h-px w-10 bg-linear-to-r from-brand-orange to-transparent"></div>
        <span class="font-mono font-medium text-[#ff8a5c] text-sm tracking-[2.88px] uppercase">TRAYECTORIA</span>
      </div>
      <h2 class="text-[32px] md:text-[38px] font-bold tracking-[-0.76px] text-white/80">Experiencia aplicada a tu contexto.</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
      {experiences.map((exp) => <ExperienceCard {...exp} />)}
    </div>
  </div>
</section>
