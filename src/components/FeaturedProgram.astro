---
import ProgramCard from "./ProgramCard.astro";

const program = {
  id: "01",
  title: "Mentoria 4 semanas",
  subtitle: "de junior/mid a developer con criterio",
  description: "Un proceso intensivo para ordenar tu aprendizaje, revisar tu codigo, resolver bloqueos reales y construir una estrategia tecnica que puedas sostener despues de la mentoria.",
  tech: ["CODE REVIEW", "ROADMAP", "ARCHITECTURE", "CAREER"],
  color: "#ef6c4a",
};
---

<section id="program" class="w-full flex justify-center relative pt-12 lg:pt-[140px] pb-24 md:pb-32">
  <div class="w-full relative flex flex-col items-start">
    <div class="relative lg:absolute top-0 lg:-top-[80px] left-0 flex items-center gap-2 mb-8 lg:mb-0" data-section-label>
      <div class="bg-linear-to-r from-brand-orange to-transparent h-px w-10"></div>
      <span class="font-mono font-medium text-[#ff8a5c] text-sm tracking-[2.88px] uppercase whitespace-nowrap">PROGRAMA</span>
    </div>
    <ProgramCard {...program} />
  </div>
</section>
