---
interface Props {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  tech: string[];
  color: string;
}

const { id, title, subtitle, description, tech, color } = Astro.props;
---

<div class="bg-white/[0.03] border border-white/[0.08] rounded-[20px] lg:rounded-[24px] group flex flex-col lg:flex-row lg:items-center lg:justify-between lg:px-12 lg:py-10 overflow-hidden transition-all duration-300 hover:border-[#DA2984]/80 hover:bg-[linear-gradient(225deg,rgba(26,20,46,0.95)_13%,rgba(18,14,34,0.95)_86%)] hover:shadow-xl hover:shadow-purple-950/40 relative">
  <div class="absolute inset-0 bg-brand-glass/60 backdrop-blur-[10px] rounded-[20px] lg:rounded-[24px] -z-10"></div>

  <div class="relative w-full lg:w-[48%] flex flex-col items-start z-10 p-6 lg:p-0">
    <p class="font-bold text-[13px] lg:text-[14px] text-[#9696af] whitespace-nowrap mb-[10px] lg:mb-[12px]">{id}</p>
    <div class="bg-brand-purple/15 border border-brand-purple/20 px-[12px] lg:px-[14px] py-[4px] lg:py-[6px] rounded-full mb-[16px] lg:mb-[20px]">
      <p class="text-brand-purple text-[10px] lg:text-[11px] font-bold tracking-[0.44px] uppercase whitespace-nowrap">Programa destacado</p>
    </div>
    <h3 class="text-[28px] lg:text-[36px] font-bold tracking-[-0.8px] text-white leading-[1.2] mb-[16px] lg:mb-[20px]">
      <span style={`color: ${color};`}>{title}</span>: {subtitle}
    </h3>
    <p class="text-[#a0a0b4] text-[13px] lg:text-[14px] font-medium leading-[1.6] mb-[20px] lg:mb-[24px] max-w-[480px]">{description}</p>
    <div class="flex flex-wrap gap-[8px] items-start">
      {tech.map((t) => (
        <div class="bg-brand-orange/8 border border-brand-orange/15 px-[12px] lg:px-[14px] py-[4px] lg:py-[6px] rounded-[6px]">
          <span class="text-[10px] lg:text-[11px] font-bold text-brand-orange/80 tracking-[0.44px] uppercase whitespace-nowrap">{t}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="relative w-full lg:w-[45%] h-[300px] lg:h-[400px] my-6 lg:mt-0 flex items-center justify-center">
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[200px] lg:w-[250px] h-[200px] lg:h-[250px] bg-brand-purple/30 blur-[60px] lg:blur-[80px] rounded-full opacity-60 group-hover:bg-brand-orange/30 transition-colors duration-1000"></div>
    <div class="relative w-[280px] sm:w-[320px] lg:w-[380px] h-[260px] sm:h-[300px] lg:h-[360px] bg-linear-to-br from-[#1a1029] to-[#0f0a1a] border border-white/10 rounded-[24px] lg:rounded-[28px] shadow-2xl overflow-hidden group-hover:scale-[1.02] transition-transform duration-700 flex flex-col justify-between p-6">
      <div class="absolute left-[40%] top-[40%] w-[150px] lg:w-[180px] h-[150px] lg:h-[180px] bg-brand-orange/15 blur-2xl lg:blur-[50px] rounded-full"></div>
      <div class="relative z-10 flex flex-col gap-4">
        {["Diagnostico tecnico", "Roadmap de estudio", "Code review", "Simulacion de entrevista"].map((item, index) => (
          <div class="flex items-center gap-3 rounded-2xl bg-white/[0.07] border border-white/10 px-4 py-3">
            <span class="flex size-7 items-center justify-center rounded-full bg-brand-orange/15 text-brand-orange text-xs font-bold">{index + 1}</span>
            <span class="text-sm font-semibold text-white/80">{item}</span>
          </div>
        ))}
      </div>
      <div class="absolute inset-0 bg-linear-to-tr from-white/5 to-transparent pointer-events-none"></div>
    </div>
  </div>
</div>
