---
import { ChevronDown, HelpCircle } from "lucide-astro";
import { faqs } from "../data/faq";
---

<section id="faq" class="py-16 lg:py-24 w-full flex flex-col items-center">
  <div class="w-full flex flex-col gap-2.5 items-start mb-10">
    <p class="font-mono font-medium text-xs tracking-[0.6px] bg-clip-text text-transparent bg-gradient-to-r from-[#DA2984] to-[#A406E9] uppercase">
      07 — FAQS
    </p>
    <h2 class="font-bold text-3xl sm:text-4xl text-white tracking-tight">
      Preguntas Frecuentes.
    </h2>
  </div>

  <div class="w-full max-w-4xl flex flex-col gap-4">
    {faqs.map((faq) => (
      <details class="group bg-white/[0.03] border border-white/[0.08] rounded-[20px] transition-all duration-300 open:bg-white/[0.05] open:border-[#DA2984]/30 overflow-hidden hover:shadow-lg hover:shadow-purple-950/20">
        <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none outline-none">
          <div class="flex items-center gap-3">
            <HelpCircle
              size={18}
              class="text-[#DA2984]/70 shrink-0 group-open:text-[#DA2984] transition-colors"
            />
            <span class="text-sm sm:text-base font-semibold text-white/90 group-hover:text-white transition-colors">
              {faq.question}
            </span>
          </div>
          <div class="w-8 h-8 rounded-full bg-white/5 border border-white/5 flex items-center justify-center text-white/60 group-open:text-[#DA2984] group-open:bg-[#DA2984]/10 group-open:border-[#DA2984]/20 transition-all">
            <ChevronDown
              size={16}
              class="transition-transform duration-300 group-open:rotate-180"
            />
          </div>
        </summary>
        <div class="px-6 pb-6 pt-1 border-t border-white/5">
          <p class="text-[#a0a0b4] text-xs sm:text-sm leading-relaxed font-medium">
            {faq.answer}
          </p>
        </div>
      </details>
    ))}
  </div>
</section>
