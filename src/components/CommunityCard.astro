---
interface Props {
  title: string;
  description: string;
  color: string;
}

const { title, description, color } = Astro.props;
---

<div class="bg-white/[0.03] border border-white/[0.08] rounded-[20px] p-7 flex flex-col gap-4 relative overflow-hidden transition-all duration-300 hover:border-[#DA2984]/80 hover:bg-[linear-gradient(225deg,rgba(26,20,46,0.95)_13%,rgba(18,14,34,0.95)_86%)] hover:shadow-xl hover:shadow-purple-950/40 group min-h-[280px]">
  <div class="w-11 h-11 rounded-[12px] bg-gradient-to-r from-[#DA2984] to-[#A406E9] flex items-center justify-center shrink-0 shadow-md shadow-purple-900/30 group-hover:scale-105 transition-transform">
    <div class="w-4 h-4 rounded-full bg-white/80"></div>
  </div>

  <div class="flex flex-col gap-2">
    <h4 class="font-semibold text-xl text-white tracking-tight group-hover:text-white transition-colors">
      {title}
    </h4>
    <p class="text-[#a0a0b4] text-sm leading-relaxed">
      {description}
    </p>
  </div>
</div>
