---
interface Props {
  company: string;
  role: string;
  period: string;
  description: string;
  color: string;
  isCurrent?: boolean;
}

const { company, role, period, description, color, isCurrent = false } = Astro.props;
---

<div class="bg-white/[0.03] border border-white/[0.08] rounded-[20px] p-7 flex flex-col items-center gap-4 relative overflow-hidden transition-all duration-300 hover:border-[#DA2984]/80 hover:bg-[linear-gradient(225deg,rgba(26,20,46,0.95)_13%,rgba(18,14,34,0.95)_86%)] hover:shadow-xl hover:shadow-purple-950/40 group min-h-[320px]">
  <div class="flex items-center gap-2.5">
    <span class="font-mono font-medium text-xs text-[#9696af] tracking-[0.48px] uppercase">{period}</span>
    {isCurrent && (
      <div class="px-2.5 py-0.5 rounded-full bg-gradient-to-r from-[#FA743F] to-[#DA2984] flex items-center justify-center shadow-sm">
        <span class="font-mono font-medium text-[9px] text-white tracking-[0.18px] uppercase">
          ACTUAL
        </span>
      </div>
    )}
  </div>

  <div class="w-14 h-14 sm:w-[68px] sm:h-[68px] rounded-full shrink-0 bg-gradient-to-r from-[#DA2984] to-[#A406E9] flex items-center justify-center font-bold text-xl sm:text-2xl text-white shadow-md shadow-purple-900/30 group-hover:scale-105 transition-transform">
    <span>{company.slice(0, 1)}</span>
  </div>

  <div class="text-center flex flex-col gap-1.5">
    <h3 class="font-bold text-xl sm:text-[22px] text-white tracking-tight">
      {role}
    </h3>
    <p class="font-semibold text-base bg-clip-text text-transparent bg-gradient-to-r from-[#FA743F] to-[#DA2984]">
      {company}
    </p>
  </div>

  <p class="text-[#a0a0b4] text-sm leading-relaxed text-center max-w-[280px]">
    {description}
  </p>
</div>
