---
import { ArrowLeft, ArrowRight } from "lucide-astro";

const testimonials = [
  {
    text: "La mentoría me ayudó a dejar de estudiar al azar. En pocas semanas tuve un roadmap claro, mejor estructura de código y más confianza para entrevistas.",
    author: "Developer Frontend",
    role: "Mentoreado",
    initials: "DF",
    color: "#DA2984",
  },
  {
    text: "El feedback fue directo y accionable. No solo resolvimos bugs: aprendí a explicar decisiones técnicas y a pensar tradeoffs como equipo.",
    author: "Fullstack Developer",
    role: "Mentoreado",
    initials: "FD",
    color: "#A406E9",
  },
  {
    text: "Llegamos con bloqueos serios en la integración de LLMs y la estructuración del backend. Rodrigo nos ayudó a rediseñar la arquitectura en un fin de semana y a definir un pipeline robusto. Clave para nuestro MVP.",
    author: "Founder & CTO",
    role: "AI Startup",
    initials: "FC",
    color: "#FA743F",
  },
];
---

<section id="testimonials" class="py-20 w-full flex flex-col items-center">
  {/* Fila de Encabezado */}
  <div class="w-full flex flex-col lg:flex-row gap-6 lg:gap-12 items-start lg:items-end justify-between mb-16">
    <div class="flex-1 space-y-3">
      <div class="flex gap-2 items-center" data-section-label>
        <div class="bg-gradient-to-r from-[#DA2984] to-transparent h-px w-10"></div>
        <p class="font-mono font-medium text-[#DA2984] text-sm tracking-[2.88px] uppercase">TESTIMONIOS</p>
      </div>
      <h2 class="font-bold text-3xl md:text-4xl text-white">Resultados de mentorías Tokidev</h2>
    </div>
    <div class="flex-1 max-w-[500px]">
      <p class="text-white/60 text-sm sm:text-base leading-relaxed">
        Feedback de developers que buscaron claridad técnica, mejores hábitos y dirección profesional real.
      </p>
    </div>
  </div>

  {/* Grid de Pasos (3 Columnas para testimonios compactos) */}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full items-stretch">
    {testimonials.map((test) => (
      <div class="reveal-card interactive-card relative rounded-3xl border border-white/8 overflow-hidden flex flex-col justify-between p-6 group transition-all duration-500 hover:scale-[1.01] hover:border-[#DA2984]/20 bg-white/3 backdrop-blur-md">
        {/* Fondo sutil */}
        <div class="absolute -top-12 -left-12 w-24 h-24 rounded-full blur-[40px] bg-white/5 group-hover:bg-[#DA2984]/5 transition-colors duration-700"></div>

        <div>
          <span class="text-3xl font-extrabold leading-none opacity-30 select-none block mb-2" style={`color: ${test.color};`}>“</span>
          <p class="text-white/70 text-xs sm:text-sm leading-relaxed mb-6 font-medium">{test.text}</p>
        </div>

        <div class="flex items-center gap-3 mt-auto">
          <div class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold text-white shrink-0" style={`background: linear-gradient(135deg, ${test.color}cc, #1a1029); border: 1px solid ${test.color}44;`}>
            {test.initials}
          </div>
          <div class="flex flex-col text-left">
            <span class="text-[12px] font-bold text-white/90 leading-none mb-1">{test.author}</span>
            <span class="text-[10px] font-medium leading-none text-white/40">{test.role}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
