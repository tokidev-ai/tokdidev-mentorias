---
import { ArrowRight, Sparkles } from "lucide-astro";
---

<section id="hero" class="relative pt-24 pb-16 lg:pt-36 lg:pb-28 flex justify-center overflow-hidden w-full">
  {/* Orbes de brillo animados centrados para evitar el look básico */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] sm:w-[500px] lg:w-[700px] h-[300px] sm:h-[400px] bg-brand-orange/15 blur-[100px] sm:blur-[140px] rounded-full pointer-events-none z-0 animate-pulse" style="animation-duration: 5s;"></div>
  <div class="absolute top-[45%] left-[45%] -translate-x-1/2 -translate-y-1/2 w-[280px] sm:w-[450px] lg:w-[600px] h-[280px] sm:h-[400px] bg-brand-purple/10 blur-[110px] sm:blur-[130px] rounded-full pointer-events-none z-0 animate-pulse" style="animation-duration: 8s; animation-delay: 1.5s;"></div>

  <div class="flex flex-col items-center text-center gap-6 lg:gap-8 z-10 w-full max-w-4xl mx-auto px-4 relative">
    {/* Badge Animado */}
    <div data-hero="badge" class="px-4 py-2 bg-brand-orange/10 backdrop-blur-md border border-brand-orange/25 rounded-full overflow-hidden inline-block animate-pulse">
      <span class="text-xs font-bold text-brand-orange uppercase tracking-[1.65px] flex items-center gap-2">
        <Sparkles size={12} class="animate-spin" style="animation-duration: 4s;" /> MENTORÍA & CONSULTORÍA TECH
      </span>
    </div>

    {/* Titular Impactante con Gradiente Animado (Text Shine) */}
    <h1 data-hero="title" class="text-3xl sm:text-4xl md:text-5xl lg:text-[56px] xl:text-[62px] font-extrabold leading-[1.15] lg:leading-[1.1] tracking-[-1.2px] lg:tracking-[-2px] text-white">
      ¿Tu código se quedó atrás o no sabes cómo <br />
      <span class="bg-linear-to-r from-brand-orange via-brand-yellow to-brand-purple bg-clip-text text-transparent animate-text-shine">integrar IA</span> en tu producto? Resuelve tus dudas.
    </h1>

    {/* Subtitular */}
    <div data-hero="desc" class="text-[#c6cad0] text-sm sm:text-base lg:text-lg leading-[1.6] max-w-[700px]">
      <p>
        Mentorías 1-a-1 y consultoría arquitectónica con un Senior Developer. El empujón que tu carrera o tu startup necesitan para escalar.
      </p>
    </div>

    {/* CTAs Centrados */}
    <div data-hero="actions" class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-2 w-full sm:w-auto">
      <a href="https://calendly.com/tokidev/sesion-gratuita" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto flex items-center justify-center gap-2.5 px-8 py-4 bg-white rounded-full text-sm font-bold text-[#0f121a] hover:bg-zinc-200 transition-colors shadow-lg hover:scale-[1.02] duration-300">
        Agendar Sesión Gratuita (20 min)
        <ArrowRight size={18} />
      </a>

      <a href="#business" class="w-full sm:w-auto flex items-center justify-center gap-2.5 px-8 py-4 bg-[#2d2550]/40 border border-brand-border/20 rounded-full text-sm font-semibold text-brand-text hover:bg-[#2d2550]/70 transition-colors hover:scale-[1.02] duration-300">
        Consultoría para Empresas
      </a>
    </div>
  </div>
</section>
