---
import { ArrowRight, Sparkles } from "lucide-astro";
---

<section id="hero" class="relative pt-24 pb-16 lg:pt-36 lg:pb-28 flex justify-center overflow-hidden w-full">
  {/* Orbes de brillo animados centrados para evitar el look básico */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] sm:w-[500px] lg:w-[700px] h-[300px] sm:h-[400px] bg-[#DA2984]/15 blur-[100px] sm:blur-[140px] rounded-full pointer-events-none z-0 animate-pulse" style="animation-duration: 5s;"></div>
  <div class="absolute top-[45%] left-[45%] -translate-x-1/2 -translate-y-1/2 w-[280px] sm:w-[450px] lg:w-[600px] h-[280px] sm:h-[400px] bg-[#A406E9]/10 blur-[110px] sm:blur-[130px] rounded-full pointer-events-none z-0 animate-pulse" style="animation-duration: 8s; animation-delay: 1.5s;"></div>

  <div class="flex flex-col items-center text-center gap-6 lg:gap-8 z-10 w-full max-w-5xl mx-auto px-4 relative">
    {/* Badge Animado */}
    <div data-hero="badge" class="px-4 py-2 bg-[#DA2984]/10 backdrop-blur-md border border-[#DA2984]/25 rounded-full overflow-hidden inline-block animate-pulse">
      <span class="text-xs font-bold text-[#DA2984] uppercase tracking-[1.65px] flex items-center gap-2">
        <Sparkles size={12} class="animate-spin" style="animation-duration: 4s;" /> MENTORÍA & CONSULTORÍA TECH
      </span>
    </div>

    {/* Titular con Rotación Dinámica de Texto */}
    <h1 data-hero="title" class="text-3xl sm:text-4xl md:text-5xl lg:text-[54px] xl:text-[60px] font-extrabold leading-[1.2] lg:leading-[1.15] tracking-[-1.2px] lg:tracking-[-2px] text-white">
      Resuelve bloqueos técnicos y escala con <br class="hidden md:block" />
      mentorías 1-a-1 para <span id="dynamic-text" class="inline-block bg-gradient-to-r from-[#DA2984] via-[#A406E9] to-[#FA743F] bg-clip-text text-transparent animate-text-shine">startups AI-First</span>
    </h1>

    {/* Subtitular */}
    <div data-hero="desc" class="text-[#c6cad0] text-sm sm:text-base lg:text-lg leading-[1.6] max-w-[800px]">
      <p>
        Consultoría arquitectónica, refactorización y estrategia de IA sin fricción. Experiencia práctica aplicada directamente a tus desafíos de desarrollo.
      </p>
    </div>

    {/* CTAs Centrados */}
    <div data-hero="actions" class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-2 w-full sm:w-auto">
      <a href="https://calendly.com/tokidev/sesion-gratuita" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto flex items-center justify-center gap-2.5 px-8 py-3.5 bg-gradient-to-r from-[#DA2984] to-[#A406E9] rounded-xl text-sm font-bold text-white hover:brightness-110 shadow-lg shadow-purple-900/30 transition-all hover:scale-[1.02] duration-300 cursor-pointer">
        Agendar Sesión Gratuita (20 min)
        <ArrowRight size={18} />
      </a>

      <a href="#business" class="w-full sm:w-auto flex items-center justify-center gap-2.5 px-8 py-3.5 bg-white/5 border border-white/10 rounded-xl text-sm font-semibold text-white hover:bg-white/10 transition-colors hover:scale-[1.02] duration-300 cursor-pointer">
        Consultoría para Empresas
      </a>
    </div>
  </div>
</section>

<script>
  const phrases = [
    "startups AI-First",
    "developers junior",
    "proyectos Angular/Node"
  ];
  let currentIndex = 0;
  const dynamicTextEl = document.getElementById("dynamic-text");

  if (dynamicTextEl) {
    setInterval(async () => {
      // 1. Animación de salida: desvanecer y desplazar hacia arriba
      const fadeOut = dynamicTextEl.animate(
        [
          { opacity: 1, transform: "translateY(0px)" },
          { opacity: 0, transform: "translateY(-8px)" }
        ],
        { duration: 250, easing: "ease-in", fill: "forwards" }
      );

      await fadeOut.finished;

      // 2. Cambiar frase
      currentIndex = (currentIndex + 1) % phrases.length;
      dynamicTextEl.textContent = phrases[currentIndex];

      // 3. Animación de entrada: desvanecer en sentido contrario y deslizar desde abajo
      dynamicTextEl.animate(
        [
          { opacity: 0, transform: "translateY(8px)" },
          { opacity: 1, transform: "translateY(0px)" }
        ],
        { duration: 300, easing: "ease-out", fill: "forwards" }
      );
    }, 3200); // Intervalo de cambio de frase (3.2s)
  }
</script>
