---
import { ArrowDown, ArrowRight, CalendarRange, Milestone, Video } from "lucide-astro";
import { workflowSteps } from "../data/workflow";

const iconMap = {
  CalendarRange,
  Video,
  Milestone,
};
---

<section id="workflow" class="py-16 lg:py-24 w-full flex flex-col items-center">
  <div class="w-full flex flex-col gap-2.5 items-start mb-10">
    <p class="font-mono font-medium text-xs tracking-[0.6px] bg-clip-text text-transparent bg-section-label uppercase">
      01 — WORKFLOW
    </p>
    <h2 class="font-bold text-3xl sm:text-4xl text-white tracking-tight">
      Así trabajamos: Directo al grano.
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full items-stretch relative">
    {workflowSteps.map((step, index) => {
      const IconComponent = iconMap[step.iconName];
      return (
        <div class="bg-white/[0.03] border border-white/[0.08] rounded-[20px] p-7 flex flex-col justify-between gap-6 relative transition-all duration-300 hover:border-magenta/80 hover:bg-card-hover hover:shadow-xl hover:shadow-purple-950/40 group">
          {index < workflowSteps.length - 1 && (
            <>
              <div class="hidden md:flex absolute top-1/2 -translate-y-1/2 left-[calc(100%_-_18px)] w-9 h-9 rounded-full bg-[#0a111a] border border-brand-border/40 items-center justify-center z-20 shadow-[0_4px_16px_rgba(0,0,0,0.6)] text-magenta group-hover:scale-110 group-hover:border-magenta/40 transition-all duration-300">
                <ArrowRight size={16} />
              </div>
              <div class="flex md:hidden absolute top-[calc(100%_-_18px)] left-1/2 -translate-x-1/2 w-9 h-9 rounded-full bg-[#0a111a] border border-brand-border/40 items-center justify-center z-20 shadow-[0_4px_16px_rgba(0,0,0,0.6)] text-magenta">
                <ArrowDown size={16} />
              </div>
            </>
          )}

          <div class="flex items-center justify-between mb-2 z-10">
            <div class="w-11 h-11 rounded-[12px] bg-icon-gradient flex items-center justify-center shrink-0 shadow-md shadow-purple-900/30 group-hover:scale-105 transition-transform">
              <IconComponent size={22} class="text-white" />
            </div>
            <span class="font-mono text-3xl font-extrabold opacity-15 text-white tracking-widest">{step.stepNum}</span>
          </div>
          
          <div class="flex flex-col gap-2 z-10">
            <h3 class="font-semibold text-xl sm:text-2xl text-white tracking-tight group-hover:text-white transition-colors">{step.title}</h3>
            <p class="text-brand-text-dim text-sm leading-relaxed">{step.description}</p>
          </div>
        </div>
      );
    })}
  </div>
</section>
