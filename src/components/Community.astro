---
import CommunityCard from "./CommunityCard.astro";

const items = [
  {
    title: "Acompanamiento practico",
    description: "No es teoria suelta. Trabajamos sobre tu codigo, tu contexto y tus decisiones reales de producto.",
    color: "#ef6c4a",
  },
  {
    title: "Comunidad y criterio",
    description: "Aprende a pensar como engineer: tradeoffs, comunicacion tecnica, ownership y ejecucion con foco.",
    color: "#7b5ea7",
  },
];
---

<section id="community" class="py-16 lg:py-24 w-full flex flex-col items-center">
  <div class="w-full flex flex-col gap-2.5 items-start mb-10">
    <p class="font-mono font-medium text-xs tracking-[0.6px] bg-clip-text text-transparent bg-gradient-to-r from-[#DA2984] to-[#A406E9] uppercase">
      ACOMPANAMIENTO
    </p>
    <h2 class="font-bold text-3xl sm:text-4xl text-white tracking-tight">
      Acompañamiento y comunidad.
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 w-full">
    {items.map((item) => <CommunityCard {...item} />)}
  </div>
</section>
