---
import BackgroundGlows from "../components/BackgroundGlows.astro";
import BusinessSection from "../components/BusinessSection.astro";
import CTA from "../components/CTA.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/Navbar.astro";
import PersonalSection from "../components/PersonalSection.astro";
import TechMarquee from "../components/TechMarquee.astro";
import Workflow from "../components/Workflow.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Tokidev Mentorías | Software, carrera y criterio técnico"
  description="Mentorías técnicas 1:1 para developers que quieren mejorar su código, arquitectura, carrera y forma de construir productos reales."
>
  <BackgroundGlows slot="background" />

  <div class="relative w-full mx-auto min-h-screen overflow-x-hidden">
    <Navbar />

    <main class="w-full relative z-10">
      <div class="w-[92%] max-w-[1120px] mx-auto">
        <Hero />
      </div>

      <TechMarquee />

      <div class="w-[92%] max-w-[1120px] mx-auto flex flex-col items-center">
        <Workflow />
        <PersonalSection />
        <BusinessSection />
        <FAQ />
        <CTA />
        <Footer />
      </div>
    </main>
  </div>
</Layout>
